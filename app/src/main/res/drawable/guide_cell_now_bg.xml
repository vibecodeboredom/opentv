<?xml version="1.0" encoding="utf-8"?>
<!-- 6.1.0: radius 8dp (was 6dp). Pressed state is a slightly darker
     accent, so touch users get feedback without losing the green
     "now" identity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#79B636" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- "Now" cell: accent green (4.6.0 palette) instead of blue. -->
            <solid android:color="#86C739" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
