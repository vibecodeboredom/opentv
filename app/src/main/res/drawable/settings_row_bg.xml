<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist row background (4.9.0): a rounded dark card by default,
     a lighter fill with an accent outline when focused, so the focused
     row is obvious on a TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#333639" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#86C739" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#333639" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#86C739" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161616" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#333639" />
        </shape>
    </item>
</selector>
