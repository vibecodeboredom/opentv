<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Settings input background (4.9.0): a rounded dark field
     with a subtle border; the border turns accent green on focus, so
     it's clear which field the remote is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#161616" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#86C739" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111111" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#333639" />
        </shape>
    </item>
</selector>
