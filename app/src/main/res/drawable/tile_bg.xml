<?xml version="1.0" encoding="utf-8"?>
<!-- Info-overlay strip tile background (4.6.1): rounded 16dp dark-grey
     tile, accent green when focused or pressed. The label/icon turn
     dark on the green background (handled in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#86C739" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#86C739" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#232629" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
