<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card with a 2dp accent outline (6.1.0): marks the
     primary action — the mobile "Continue watching" card — so it
     stands out from the plain channel rows below it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#161616" />
    <corners android:radius="16dp" />
    <stroke
        android:width="2dp"
        android:color="#86C739" />
</shape>
