<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenTV" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 6.1.5: launch splash. MainActivity runs under this theme so the
         very first frame (before the layout inflates) already shows the
         dark background and the banner logo instead of a plain black
         flash. MainActivity switches back to Theme.OpenTV in onCreate
         before super.onCreate(); the loading layout then covers the
         window background with the same colour, so nothing shifts. -->
    <style name="Theme.OpenTV.Splash" parent="Theme.OpenTV">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.OpenTV.Playback" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 5.0.0: the guide's hold-OK menu slides in from the right edge
         (and back out the same way) instead of the default dialog
         fade / slide-up. -->
    <style name="GuideMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
