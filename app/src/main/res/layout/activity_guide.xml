<?xml version="1.0" encoding="utf-8"?>
<!-- Guide, rebuilt from scratch to match the TiviMate reference photo:
     a big details header (preview box + programme info), then the grid.
     No title bar, no search bar, no Now button in the guide itself —
     search lives in the long-press context menu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Details header: preview box + selected programme info.
         Kept compact so more channel rows fit on screen.
         6.0.0-rc1: on mobile the header shrinks in code (see
         GuideActivity) so it fits a phone screen. -->
    <LinearLayout
        android:id="@+id/guide_header"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Preview box: selected channel's logo. -->
        <FrameLayout
            android:id="@+id/guide_preview_box"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@drawable/guide_preview_bg">

            <ImageView
                android:id="@+id/guide_detail_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@string/guide_preview" />

            <TextView
                android:id="@+id/guide_detail_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </FrameLayout>

        <!-- Programme details. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/guide_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Favorite star: tap to favorite/unfavorite the channel. -->
                <TextView
                    android:id="@+id/guide_detail_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="☆"
                    android:textColor="#7A7A85"
                    android:textSize="26sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/guide_detail_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C9C9D1"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/guide_detail_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/guide_progress_drawable" />

                <TextView
                    android:id="@+id/guide_detail_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#C9C9D1"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/guide_detail_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="#9A9AA3"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/guide_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp" />

    <!-- 4.7.2: the channel column is now PINNED. It used to live inside
         the HorizontalScrollView (one channel cell per row), so scrolling
         right scrolled the names away — and Left on the first programme
         card opened the sidebar, so there was no way to get them back.
         Now the names sit in their own column beside the horizontal
         scroller: both columns share the same vertical ScrollView, so
         they scroll up/down together, but the names never scroll
         sideways. The programme grid (guide_container) holds only the
         time header and the programme cards. -->
    <ScrollView
        android:id="@+id/guide_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/guide_pinned_col"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <HorizontalScrollView
                android:id="@+id/guide_hscroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/guide_frame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/guide_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Current-time indicator line. Positioned in code. -->
                    <View
                        android:id="@+id/guide_now_line"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="#FF3B30"
                        android:visibility="gone" />

                </FrameLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/guide_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:text="@string/guide_no_results"
        android:textColor="#9A9AA3"
        android:textSize="18sp"
        android:visibility="gone" />
</LinearLayout>

    <!-- Left sidebar scrim (4.6.2): 60% black over the guide. -->
    <View
        android:id="@+id/guide_sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#98000000"
        android:visibility="gone" />

    <!-- Left sidebar (4.6.2): a 260dp panel docked to the left, same as
         the playback sidebar (shared ChannelSidebar helper). -->
    <LinearLayout
        android:id="@+id/guide_sidebar"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111111"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/guide_sidebar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />

            <TextView
                android:id="@+id/guide_sidebar_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF"
                android:maxLines="1" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/guide_sidebar_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/guide_sidebar_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </ScrollView>

        <TextView
            android:id="@+id/guide_sidebar_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="2" />

    </LinearLayout>

</FrameLayout>
