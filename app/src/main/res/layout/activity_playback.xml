<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Paused cluster (4.6.0, TiviMate-style): a large centred play icon
         shown while playback is paused; tapping it (or the transport
         play/pause button, or the remote's play/pause key) resumes. -->
    <ImageView
        android:id="@+id/paused_cluster"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/loading_status_bg"
        android:padding="20dp"
        android:src="@drawable/ic_play"
        android:contentDescription="@string/play"
        android:visibility="gone" />

    <!-- Left sidebar scrim (4.6.0): 60% black over the video. -->
    <View
        android:id="@+id/sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#98000000"
        android:visibility="gone" />

    <!-- Left sidebar (4.6.1, TiviMate-style): a 260dp panel docked to the
         left, listing groups at the top and channels below. Rows are built
         in code (groups, then the selected group's channels). -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111111"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header: group/playlist name + channel count. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/sidebar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />

            <TextView
                android:id="@+id/sidebar_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Rows (groups or channels), built in code. -->
        <ScrollView
            android:id="@+id/sidebar_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sidebar_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </ScrollView>

        <!-- Footer: channel count / truncation note. -->
        <TextView
            android:id="@+id/sidebar_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="2" />

    </LinearLayout>

    <!-- Channel info overlay (4.6.0, restyled to the TiviMate player
         pattern; 4.6.3 made it smaller and more transparent): 50% black
         panel anchored to the bottom. Top: group + date/time. Middle:
         now / next with times. Then logo + channel name, the strip of
         tiles (TV guide, History, recents, Clear). Bottom: a 48dp bar
         with a 14sp bold title on the left and icon-only transport
         buttons on the right. A thin progress track runs along the very
         bottom edge. -->
    <LinearLayout
        android:id="@+id/channel_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:background="#80000000"
        android:visibility="gone">

        <!-- Top bar: group (left) + date/time (right). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/info_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/info_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Current / next programme. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_now_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />

            <TextView
                android:id="@+id/info_now_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF" />

            <TextView
                android:id="@+id/info_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <!-- Channel identity: logo + name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/info_logo"
                android:layout_width="88dp"
                android:layout_height="52dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/guide_preview" />

            <TextView
                android:id="@+id/info_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Bottom strip: TV guide, History, recent channels, Clear.
             Tiles are built in code (recents are dynamic). -->
        <LinearLayout
            android:id="@+id/info_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center" />

        <!-- Bottom transport bar: 48dp, 14sp bold title left, icon-only
             transport buttons right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/transport_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/transport_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/transport_button_bg"
                android:src="@drawable/ic_prev"
                android:contentDescription="@string/transport_prev_channel"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageButton
                android:id="@+id/transport_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/transport_button_bg"
                android:src="@drawable/ic_pause"
                android:contentDescription="@string/play"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageButton
                android:id="@+id/transport_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/transport_button_bg"
                android:src="@drawable/ic_next"
                android:contentDescription="@string/transport_next_channel"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageButton
                android:id="@+id/transport_record"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/transport_button_bg"
                android:src="@drawable/ic_record"
                android:contentDescription="@string/menu_record"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageButton
                android:id="@+id/transport_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/transport_button_bg"
                android:src="@drawable/ic_star"
                android:contentDescription="@string/menu_add_favorite"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Thin progress track at the very bottom edge: the current
             programme's progress. -->
        <ProgressBar
            android:id="@+id/info_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/guide_progress_drawable" />

    </LinearLayout>

</FrameLayout>
