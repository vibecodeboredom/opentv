<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Channel info overlay (TiviMate-style): shown when left/right is
         pressed. A compact panel anchored to the bottom of the screen —
         it never covers the whole picture. Top: group + date/time.
         Middle: now / next with times + progress bar. Bottom: logo +
         channel name, then the strip of tiles — TV guide, History, the
         3 most recent channels, Clear. -->
    <LinearLayout
        android:id="@+id/channel_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#E6000000"
        android:visibility="gone">

        <!-- Top bar: group (left) + date/time (right). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/info_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/info_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Current / next programme. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_now_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />

            <TextView
                android:id="@+id/info_now_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="17sp"
                android:textColor="#DDDDDD" />

            <TextView
                android:id="@+id/info_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="17sp"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <!-- Current programme progress. -->
        <ProgressBar
            android:id="@+id/info_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/guide_progress_drawable" />

        <!-- Channel identity at the bottom of the panel: logo + name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/info_logo"
                android:layout_width="120dp"
                android:layout_height="72dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/guide_preview" />

            <TextView
                android:id="@+id/info_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Bottom strip: TV guide, History, recent channels, Clear.
             Tiles are built in code (recents are dynamic). -->
        <LinearLayout
            android:id="@+id/info_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
