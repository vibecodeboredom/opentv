<?xml version="1.0" encoding="utf-8"?>
<!-- Guide context menu (long-press OK on a programme), TiviMate style:
     rounded dark panel with search, settings, and programme/channel actions.
     5.0.1: the content is taller than the screen (search + up to 5 recent
     rows + 11 action rows) and the old plain LinearLayout had no
     scrolling, so buttons below the fold were laid out off-screen and
     D-pad focus could never reach them. Wrap it in a ScrollView:
     focus auto-scrolls the focused row into view, so every button is
     reachable. The slide-in animation is a window animation and is
     untouched. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="match_parent"
    android:background="@drawable/guide_panel_bg"
    android:padding="8dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <EditText
        android:id="@+id/menu_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/guide_menu_search_bg"
        android:hint="@string/menu_search_hint"
        android:textColor="#121218"
        android:textColorHint="#7A7A85"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <!-- Recent searches (4.9.3): shown under the search field while it
         is empty, so a past query can be re-run without typing it again.
         Populated in code; at most MAX_RECENT_SEARCHES_SHOWN rows so
         the full-height menu never overflows the screen. -->
    <LinearLayout
        android:id="@+id/menu_recent_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_recent_searches"
                android:textColor="#9A9AA3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_clear_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_clear_recent"
                android:textColor="#86C739"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/menu_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.0.0 (Nova): pending programme reminders — the list is
         reachable from any programme's menu, not just a reminded
         one, so it sits with Settings at the top. -->
    <TextView
        android:id="@+id/menu_my_reminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_my_reminders"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.1.0 (Nova): jump back to the programme on now — the grid
         opens there, but after browsing hours away there was no
         way back short of reopening the guide. -->
    <TextView
        android:id="@+id/menu_jump_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_jump_now"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 9.1.0 (Nova): jump the grid to prime time (19:00 today,
         or tomorrow's once tonight is effectively over). -->
    <TextView
        android:id="@+id/menu_tonight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_tonight"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.2.0 (Nova): browse a day forward/back — the grid's
         window shifts by 24h. Previous day hides in code while
         the grid is on today; jump to now returns from any day. -->
    <TextView
        android:id="@+id/menu_next_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_next_day"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_prev_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_prev_day"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.1.0 (Nova): restrict the grid to one channel group; the
         label carries the active filter (set in code) and the row
         hides in code when the playlist has fewer than two groups. -->
    <TextView
        android:id="@+id/menu_group_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_group_filter"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.1.1 (Nova): how many hours the grid shows at once; the
         label carries the current span (set in code). -->
    <TextView
        android:id="@+id/menu_guide_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_guide_zoom"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.1.1 (Nova): bring back every hidden channel; the label
         carries the hidden count (set in code) and the row hides
         in code when nothing is hidden. -->
    <TextView
        android:id="@+id/menu_unhide_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_unhide_all"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 9.1.0 (Nova): arrange the favorites into the user's own
         order. Hides in code when fewer than two favorites are
         visible — there would be nothing to arrange. -->
    <TextView
        android:id="@+id/menu_reorder_favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_reorder_favorites"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_programme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#86C739"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_external_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_external_player"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_record"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_custom_recording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_custom_recording"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.0.0 (Nova): set / remove a reminder for this programme.
         Hidden in code for programmes that are not in the future
         (or are "No information" placeholders). -->
    <TextView
        android:id="@+id/menu_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_set_reminder"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.2.0 (Nova): schedule a recording of this programme.
         Same visibility rule as the reminder row — future real
         programmes only; the label flips to a cancel in code. -->
    <TextView
        android:id="@+id/menu_record_programme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_record_programme"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 8.2.1 (Nova): set the reminder and the scheduled
         recording for this programme in one tap. Same visibility
         rule as the two rows above; the label shows as set in
         code when both are set. -->
    <TextView
        android:id="@+id/menu_remind_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_remind_and_record"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#86C739"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_favorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_add_favorite"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_block_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_hide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_hide_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_assign_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_assign_epg"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_channel_options"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    </LinearLayout>
</ScrollView>
