<?xml version="1.0" encoding="utf-8"?>
<!-- Guide context menu (long-press OK on a programme), TiviMate style:
     rounded dark panel with search, settings, and programme/channel actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/guide_panel_bg"
    android:padding="8dp">

    <EditText
        android:id="@+id/menu_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/guide_menu_search_bg"
        android:hint="@string/menu_search_hint"
        android:textColor="#121218"
        android:textColorHint="#7A7A85"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <!-- Recent searches (4.9.3): shown under the search field while it
         is empty, so a past query can be re-run without typing it again.
         Populated in code; at most MAX_RECENT_SEARCHES_SHOWN rows so
         the full-height menu never overflows the screen. -->
    <LinearLayout
        android:id="@+id/menu_recent_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_recent_searches"
                android:textColor="#9A9AA3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_clear_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_clear_recent"
                android:textColor="#86C739"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/menu_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_programme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#86C739"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_external_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_external_player"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_record"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_custom_recording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_custom_recording"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#86C739"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_favorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_add_favorite"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_block_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_hide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_hide_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_assign_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_assign_epg"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_channel_options"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
