<?xml version="1.0" encoding="utf-8"?>
<!-- Guide context menu (long-press OK on a programme), TiviMate style:
     rounded dark panel with search, settings, and programme/channel actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/guide_panel_bg"
    android:padding="8dp">

    <EditText
        android:id="@+id/menu_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/guide_menu_search_bg"
        android:hint="@string/menu_search_hint"
        android:textColor="#121218"
        android:textColorHint="#7A7A85"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <TextView
        android:id="@+id/menu_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_programme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3B82F6"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_external_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_external_player"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_record"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_custom_recording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_custom_recording"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3B82F6"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:id="@+id/menu_favorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_add_favorite"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_block_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_hide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_hide_channel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_assign_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_assign_epg"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/menu_channel_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/guide_menu_item_bg"
        android:text="@string/menu_channel_options"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
