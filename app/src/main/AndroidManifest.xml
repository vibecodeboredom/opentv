<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".OpenTvApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_banner"
        android:banner="@drawable/ic_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenTV"
        android:usesCleartextTraffic="true">

        <!-- 6.0.0-rc1: screen orientation is NOT forced here any more.
             DeviceType.applyOrientation() locks each activity to
             landscape on a TV and leaves it free (portrait allowed)
             on a phone/tablet — see DeviceType.kt. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.OpenTV.Splash"
            android:exported="true">
            <!-- 6.0.0-rc1: first mobile-capable release. The LAUNCHER
                 category lets the app appear in phone launchers; on a
                 phone it opens the touch home screen (MobileHomeActivity),
                 on a TV it auto-plays as before. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Touch-first home screen (6.0.0-rc1): phones/tablets only.
             MainActivity routes mobile here instead of auto-playing. -->
        <activity
            android:name=".MobileHomeActivity"
            android:exported="false" />

        <activity
            android:name=".PlaybackActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenTV.Playback" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".GuideActivity"
            android:exported="false" />

        <activity
            android:name=".RecordingsActivity"
            android:exported="false" />

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".RecordStopReceiver"
            android:exported="false" />

    </application>

</manifest>
